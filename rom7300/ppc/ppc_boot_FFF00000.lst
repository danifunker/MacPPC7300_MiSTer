; ============================================================================
; PowerPC exception vectors and boot code (FFF00000)
; ============================================================================
; ROM offset 300000-30BFFF, physical FFF00000-FFF0BFFF (MSR[IP]=1 at reset: vectors here).
; Exception vectors every 0x100 bytes; the reset vector (FFF00100) branches into the
; hardware start-up at FFF03000 (CPU type, BATs, Hammerhead, Bandit PCI, Cuda, RAM sizing)
; and then hands over to Open Firmware (FFF3003C). Later the NanoKernel installs its
; own vectors. Hardware addresses of the 7600 map are annotated where the code forms them.
;
; Columns: address, flag, raw bytes, instruction, ; comment.
;   flag '*' executed in the coverage run, ' ' reached by control flow,
;   '?' decodes as code but neither executed nor reached, 'd' data.

FFF00000? 48000008  b       loc_FFF00008
FFF00004? 48000028  b       loc_FFF0002C
loc_FFF00008:
FFF00008? 7C3143A6  mtspr   SPRG1, r1
FFF0000C? 7C2802A6  mfspr   r1, LR
FFF00010? 7C3243A6  mtspr   SPRG2, r1
FFF00014? 7C3342A6  mfspr   r1, SPRG3
FFF00018? 80210000  lwz     r1, 0x0(r1)
FFF0001C? 7C2803A6  mtspr   LR, r1
FFF00020? 4E800021  blrl
FFF00024d 00000000  .long   0x00000000
FFF00028? 7C2802A6  mfspr   r1, LR
loc_FFF0002C:
FFF0002C? 7C3143A6  mtspr   SPRG1, r1
FFF00030? 7C3342A6  mfspr   r1, SPRG3
FFF00034? 7C3243A6  mtspr   SPRG2, r1
FFF00038? 7C2803A6  mtspr   LR, r1
FFF0003C? 80210000  lwz     r1, 0x0(r1)
FFF00040d 00000000  .long   0x00000000
FFF00044? 4E800021  blrl
FFF00048d ........  .space  0x38                      ; zero to FFF00080
FFF00080d 0000D000  .long   0x0000D000
FFF00084d ........  .space  0x7C                      ; zero to FFF00100
; Reset vector (MSR[IP]=1 at reset, so the CPU starts here).
; r1 -> SPRG1, CR -> SPRG2, then SRR1 is moved to CR: "bne cr7" tests SRR1[RI]
; (bit 30). RI = 0 means a hard reset -> FFF03000. Otherwise HID0 goes to CR and
; "bns cr3" tests HID0 bit 15 (NHR, "not hard reset", 603/604): clear -> FFF03000.
; A soft reset (RI and NHR set) dispatches through the vector table SPRG3 points to
; (entry +4). An emulator/FPGA must present SRR1[RI]=0 or HID0[NHR]=0 at power-on.
; FFF00104 is the 601 variant of the same code (entered by "b" at 0x104).

vec_0100_reset:
FFF00100* 48000008  b       loc_FFF00108
FFF00104? 48000050  b       loc_FFF00154
loc_FFF00108:
FFF00108* 7C3143A6  mtspr   SPRG1, r1
FFF0010C* 7C200026  mfcr    r1
FFF00110* 7C3243A6  mtspr   SPRG2, r1
FFF00114* 7C3B02A6  mfspr   r1, SRR1
FFF00118* 7C2FF120  mtcr    r1
FFF0011C* 409E2EE4  bne     cr7, loc_FFF03000                  ; SRR1[RI] = 0: hard reset
FFF00120  7C30FAA6  mfspr   r1, HID0
FFF00124  7C2FF120  mtcr    r1
FFF00128  408F2ED8  bns     cr3, loc_FFF03000                  ; HID0[NHR] = 0: hard reset
FFF0012C  7C3242A6  mfspr   r1, SPRG2
FFF00130  7C2FF120  mtcr    r1
FFF00134  7C2802A6  mfspr   r1, LR
FFF00138  7C3243A6  mtspr   SPRG2, r1
FFF0013C  7C3342A6  mfspr   r1, SPRG3
FFF00140  80210004  lwz     r1, 0x4(r1)
FFF00144  7C2803A6  mtspr   LR, r1
FFF00148  4E800021  blrl
FFF0014Cd 00000100  .long   0x00000100
FFF00150? 7C200026  mfcr    r1
