FFF03170* 2C033001  cmpwi   cr0, r3, 0x3001                    ; TNT: CPU_ID top byte 0x39
FFF03174* 3AA00001  li      r21, 0x1
FFF03178* 4D820020  beqlr
FFF0317C* 3AA00000  li      r21, 0x0
FFF03180* 4E800020  blr
