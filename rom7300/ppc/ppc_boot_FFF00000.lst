FFF02F44? 4E800021  blrl
FFF02F48d ........  .space  0xB8                      ; zero to FFF03000
; Hardware start-up. PVR >> 16 selects the CPU set-up:
;   1 (601): HID0 |= 80000020
;   3, 6, 7 (603, 603e, 603ev): HID0 |= 02508000 | 4000 (caches on, DPM)
;   4 (604) and anything else: HID0 = 8000CC84 (caches enabled and invalidated,
;   BHT on), performance monitor (MMCR0, PMC1, PMC2, SDA) cleared.
; Then the start-up sequence at FFF03114 calls, in order:
;   FFF03164  r21 = 1 if Hammerhead CPU_ID>>16 == 3001 (another machine), else 0
;   FFF03184  clear the BATs; map F0000000-FFFFFFFF 1:1 with DBAT0 (cache-
;             inhibited, 256 MB) and turn MSR[DR] on (601: SR15 = 87F0000F)
;   FFF03268  Hammerhead WHO_AM_I bit 0x08000000 set -> secondary CPU: park
;   FFF03814  Bandit: config reg 0C of Bandit (IDSEL AD11), then Grand Central
;             (IDSEL AD16): BAR0 = F3000000, command = 0016; GC int mask
;   FFF047E8  MACE PLSCC = 07
;   FFF047FC  (r21 = 1 only) Cuda I2C writes
;   FFF048C0  VIA init, Cuda synchronisation, Cuda I2C write (addr 88: 61 55)
;   FFF03EB8  start the boot chime: AWACS + DBDMA audio-out from ROM
;   FFF04024  memory: Hammerhead timing from CPU_SPEED, bank bases, RAM sizing,
;             bank packing, bank table saved in NVRAM (1044, 1048+8n, 104C+8n)
;   FFF03EA8  r29 = ConfigInfo (FFF00000 + [FFF00080] = FFF0D000)
;   FFF04E00  run the HWInit/diagnostics code (FFF2003C); failure -> error beep
;   FFF038C8  r22 = first populated bank (from the NVRAM bank table); clear
;             1240 bytes there (dcbz): the boot info area
;   FFF03924  copy the bank table to the info area (r22+1000)
;   FFF0399C  measure the bus clock (VIA T1 vs DEC) and CPU clock (DEC-timed
;             loop); store CPU/bus/timebase Hz at r22+1104/1108/110C
;   FFF03D48  L2 cache (Hammerhead L2 register)
;   FFF03408  clear the BATs
;   FFF04E38  run Open Firmware (FFF3003C) with r3 = r22+1000, r4 = r22+1100,
;             r5 = PA_OpenFirmware (00400000); Open Firmware returns when it boots
;             the Mac OS
;   FFF03408  clear the BATs
;   FFF04E70  jump to the NanoKernel (ConfigInfo + KernelCodeOffset = FFF10000)
;             with r3 = ConfigInfo, r4..r6 = info areas, r7 = Open Firmware result
loc_FFF03000:
FFF03000* 7C9F42A6  mfspr   r4, PVR
FFF03004* 5484843E  srwi    r4, r4, 16
FFF03008* 2C040001  cmpwi   cr0, r4, 0x1
FFF0300C* 41820038  beq     loc_FFF03044
FFF03010* 2C040003  cmpwi   cr0, r4, 0x3
FFF03014* 41820044  beq     loc_FFF03058
FFF03018* 2C040004  cmpwi   cr0, r4, 0x4
FFF0301C* 418200B4  beq     loc_FFF030D0
FFF03020  2C040006  cmpwi   cr0, r4, 0x6
FFF03024  41820034  beq     loc_FFF03058
FFF03028  2C040007  cmpwi   cr0, r4, 0x7
FFF0302C  4182002C  beq     loc_FFF03058
FFF03030  2C040008  cmpwi   cr0, r4, 0x8
FFF03034  4182004C  beq     loc_FFF03080
FFF03038  2C040009  cmpwi   cr0, r4, 0x9
FFF0303C  41820094  beq     loc_FFF030D0
FFF03040  48000090  b       loc_FFF030D0
