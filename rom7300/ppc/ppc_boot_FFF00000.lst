FFF00154? 7C3143A6  mtspr   SPRG1, r1
FFF00158? 7C3B02A6  mfspr   r1, SRR1
FFF0015C? 7C3243A6  mtspr   SPRG2, r1
FFF00160? 409E2EA0  bne     cr7, loc_FFF03000
FFF00164? 7C2FF120  mtcr    r1
FFF00168? 7C2FF120  mtcr    r1
FFF0016C? 7C30FAA6  mfspr   r1, HID0
FFF00170? 7C3242A6  mfspr   r1, SPRG2
FFF00174? 408F2E8C  bns     cr3, loc_FFF03000
FFF00178? 7C2802A6  mfspr   r1, LR
FFF0017C? 7C2FF120  mtcr    r1
FFF00180? 7C3342A6  mfspr   r1, SPRG3
FFF00184? 7C3243A6  mtspr   SPRG2, r1
FFF00188? 7C2803A6  mtspr   LR, r1
FFF0018C? 80210004  lwz     r1, 0x4(r1)
